# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Postgres credentials. Defaults shown are used if these are unset —
# fine for local dev, but override for anything beyond that.
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=logdb

# Slack Incoming Webhook URL for anomaly alerts.
# Leave empty/unset to disable alerting entirely.
# Get one at https://api.slack.com/apps -> your app -> Incoming Webhooks
SLACK_WEBHOOK_URL=


# React frontend's ingestion API URL, baked in at Docker build time
# (not runtime — this is a Vite/browser build constraint).
VITE_API_URL=http://localhost:8000
